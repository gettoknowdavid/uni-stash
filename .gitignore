### --- General ---
.DS_Store
Thumbs.db
*.log
.env
.env.*
!.env.example
.vscode/
.idea/
*.iml
.direnv/

### --- Rust (apps/api/) ---
apps/api/target/
apps/api/**/*.rs.bk
**/*.pdb

# sqlx offline query cache — committed so CI can build with SQLX_OFFLINE=true
# Regenerate with: cargo sqlx prepare --workspace

# Shuttle.rs
apps/api/Secrets.toml
apps/api/Secrets.dev.toml
.shuttle-storage/

### --- Flutter / Dart (apps/mobile/) ---
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.packages
apps/mobile/.pub-cache/
apps/mobile/.pub/
apps/mobile/build/
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/ios/Flutter/Flutter.framework
apps/mobile/ios/Flutter/Flutter.podspec
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/**/GeneratedPluginRegistrant.java
apps/mobile/**/generated_plugin_registrant.dart
apps/mobile/*.iml
apps/mobile/coverage/
apps/mobile/*.g.dart
apps/mobile/*.freezed.dart

# Flutter secure config / keys (never commit signing keys or API keys)
apps/mobile/android/key.properties
apps/mobile/**/google-services.json
apps/mobile/**/GoogleService-Info.plist
apps/mobile/ios/Runner/GeneratedPluginRegistrant.*

### --- Secrets & credentials (belt and suspenders on top of .env) ---
*.pem
*.key

# Exception: test-only RSA keypair fixtures, committed deliberately so CI can
# run CM-1.5/CM-3.2 unit tests without generating keys (never a real secret).
!apps/api/tests/fixtures/
!apps/api/tests/fixtures/*.pem
jwt_private_key*
jwt_public_key*
r2_credentials*
*.p12
*.keystore

### --- Load testing output (keep results.md, ignore raw k6 dumps) ---
apps/api/load-tests/*.json
apps/api/load-tests/raw/

.freebuff/
