  "query": "SELECT id, chat_id, sender_id, body, read_at, created_at\n               FROM messages\n               WHERE chat_id = $1\n                 AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3::uuid))\n               ORDER BY created_at DESC, id DESC\n               LIMIT $4",
