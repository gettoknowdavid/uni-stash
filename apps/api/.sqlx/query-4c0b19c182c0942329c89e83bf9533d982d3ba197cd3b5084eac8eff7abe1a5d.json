  "query": "SELECT l.id, l.title, l.description, l.price, l.currency AS \"currency: String\", l.barter_request, l.condition, l.status, l.created_at,\n                    u.id AS seller_id, u.display_name AS seller_display_name,\n                    c.id AS category_id, c.slug AS category_slug, c.label AS category_label\n             FROM listings l\n             JOIN users u ON u.id = l.seller_id\n             JOIN categories c ON c.id = l.category_id\n             WHERE l.id = $1",
