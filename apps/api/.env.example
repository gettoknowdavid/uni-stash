# Copy to `.env` and fill in real values. All vars are required by
# `Config::from_env()` (CM-1.2) except PORT, which defaults to 8080.
DATABASE_URL=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
RESEND_API_KEY=
RESEND_BASE_URL=
# Comma-separated list of allowed school-email domains, e.g. uniport.edu.ng
ALLOWED_EMAIL_DOMAINS=
PORT=
# dev | prod
ENV=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
