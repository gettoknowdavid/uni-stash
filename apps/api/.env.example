[TEMPLATE]
# Copy to `.env` and fill in real values. All vars are required by
# `Config::from_env()` (CM-1.2) except PORT, which defaults to 8080.
#
# Local dev: `docker compose up -d` then use this URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uni_stash

# JWT keys: use _FILE variant to load PEM from disk (recommended for local dev),
# or paste the PEM content directly (for Render or other PaaS).
# File-based: set the path to the .pem file
JWT_PRIVATE_KEY_FILE=secrets/jwt_private_dev.pem
JWT_PUBLIC_KEY_FILE=secrets/jwt_public_dev.pem
# Inline: paste PEM content directly (alternative to _FILE)
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# SMTP (Brevo, Mailgun, SendGrid, etc.)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login@smtp-brevo.com
SMTP_PASSWORD=your_smtp_key
SMTP_FROM=Your Name <your@email.com>

PORT=
# dev | prod | staging
ENV=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
FRONTEND_BASE_URL=http://localhost:3000
