# Copy to `.env` and fill in real values. All vars are required by
# `Config::from_env()` (CM-1.2) except PORT, which defaults to 8080.
#
# Local dev: `docker compose up -d` then use this URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uni_stash
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
RESEND_API_KEY=
RESEND_BASE_URL=
PORT=
# dev | prod
ENV=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
FRONTEND_BASE_URL=http://localhost:3000

